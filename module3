    career stage = NULL

This prevents future OpenAlex publications from creating negative career ages.

CAREER STAGE
------------
0-5
6-10
11-19
20-29
30+

PRODUCTIVITY
------------
Raw total OpenAlex article/review count is retained.

Raw prior OpenAlex article/review count is retained.

Prior productivity bins:
0-4
5-9
10-24
25-49
50-99
100+

==============================================================================*/


/*==============================================================================
SECTION 1. FOCAL AUTHOR x ACCEPTED YEAR
==============================================================================*/

CREATE OR REPLACE TABLE `redo.ai_focal_author_years`
AS

SELECT DISTINCT

    author_id,

    accepted_year

FROM `redo.ai_paper_authors`

WHERE author_id IS NOT NULL;


/*==============================================================================
SECTION 2. TEMPORALLY VALID OPENALEX CAREER START
==============================================================================

For each author x focal accepted year:

    earliest OpenAlex article/review published on or before focal year.

We use publication_year because the complete OpenAlex historical corpus does
not provide a comparable accepted_date.

==============================================================================*/

CREATE OR REPLACE TABLE `redo.ai_openalex_career_by_author_year`
AS

SELECT

    f.author_id,

    f.accepted_year,

    MIN(
        a.publication_year
    ) AS openalex_first_article_review_year_by_focal_year

FROM `redo.ai_focal_author_years` AS f

LEFT JOIN `redo.ai_openalex_author_year` AS a

    ON f.author_id = a.author_id

    AND a.publication_year <= f.accepted_year

GROUP BY

    f.author_id,

    f.accepted_year;


/*==============================================================================
SECTION 3. REBUILD FINAL M3
==============================================================================*/

CREATE OR REPLACE TABLE `redo.ai_author_history`

CLUSTER BY
    author_id,
    accepted_year,
    subfield_id

AS

SELECT

    /*==========================================================================
      IDENTIFIERS
    ==========================================================================*/

    h.openalex_id,

    h.article_pmc,

    h.author_id,


    /*==========================================================================
      AUTHOR ROLE
    ==========================================================================*/

    h.is_first_author,

    h.is_last_author,

    h.is_corresponding_author,

    h.is_first_corresponding,

    h.is_last_corresponding,

    h.primary_author_country,

    h.primary_author_institution_id,


    /*==========================================================================
      PAPER TIMING
    ==========================================================================*/

    h.accepted_date,

    h.accepted_year,

    h.accepted_quarter,

    h.accepted_month,

    h.accepted_month_date,

    h.accepted_quarter_date,

    h.accepted_year_quarter,

    h.ai_era,


    /*==========================================================================
      AI
    ==========================================================================*/

    h.ai_score,

    h.n_ai_sentences,

    h.log_ai_sentences,


    /*==========================================================================
      PAPER TYPE
    ==========================================================================*/

    h.work_type,

    h.is_article,

    h.is_review,


    /*==========================================================================
      TEAM / AUTHORSHIP QUALITY
    ==========================================================================*/

    h.authors_count,

    h.team_size_category,

    h.team_middle_4_6,

    h.authorship_dedup_required,

    h.all_authors_resolved,


    /*==========================================================================
      DISCIPLINE
    ==========================================================================*/

    h.topic_id,

    h.subfield_id,

    h.field_id,

    h.domain_id,


    /*==========================================================================
      JOURNAL
    ==========================================================================*/

    h.source_id,

    h.source_name,


    /*==============================================================================
      OPENALEX-WIDE CAREER
==============================================================================*/

cy.openalex_first_article_review_year_by_focal_year
    AS openalex_first_article_review_year,


/*
Raw total number of article/review works observed for the author across
the OpenAlex history available in this snapshot.

Descriptive/raw measure only.
*/

oa.openalex_total_article_review_count,


/*==============================================================================
      OPENALEX-OBSERVED CAREER AGE
==============================================================================*/

/*
Definition:

    career age = focal accepted year
                 - earliest OpenAlex article/review year observed
                   on or before the focal year.

When no qualifying prior article/review is observed:

    career age = 0

This does NOT claim that the author's true career literally began in the
focal year. It means that no earlier qualifying publication is observed
in the available OpenAlex author history by that focal year.
*/

CASE

    WHEN
        cy.openalex_first_article_review_year_by_focal_year IS NULL

        THEN 0

    ELSE

        h.accepted_year
        -
        cy.openalex_first_article_review_year_by_focal_year

END AS approximate_career_age,


/*==============================================================================
      CAREER-STAGE
==============================================================================*/

CASE

    /*
    No prior OpenAlex article/review observed by focal year.

    Classified as 0-5 because the observed career age is defined as 0.
    */

    WHEN
        cy.openalex_first_article_review_year_by_focal_year IS NULL

        THEN '0-5'


    WHEN
        h.accepted_year
        -
        cy.openalex_first_article_review_year_by_focal_year
        BETWEEN 0 AND 5

        THEN '0-5'


    WHEN
        h.accepted_year
        -
        cy.openalex_first_article_review_year_by_focal_year
        BETWEEN 6 AND 10

        THEN '6-10'


    WHEN
        h.accepted_year
        -
        cy.openalex_first_article_review_year_by_focal_year
        BETWEEN 11 AND 19

        THEN '11-19'


    WHEN
        h.accepted_year
        -
        cy.openalex_first_article_review_year_by_focal_year
        BETWEEN 20 AND 29

        THEN '20-29'


    WHEN
        h.accepted_year
        -
        cy.openalex_first_article_review_year_by_focal_year
        >= 30

        THEN '30+'


    ELSE NULL

END AS career_stage,


/*==============================================================================
      CAREER-STAGE ORDER
==============================================================================*/

CASE

    WHEN
        cy.openalex_first_article_review_year_by_focal_year IS NULL

        THEN 1


    WHEN
        h.accepted_year
        -
        cy.openalex_first_article_review_year_by_focal_year
        BETWEEN 0 AND 5

        THEN 1


    WHEN
        h.accepted_year
        -
        cy.openalex_first_article_review_year_by_focal_year
        BETWEEN 6 AND 10

        THEN 2


    WHEN
        h.accepted_year
        -
        cy.openalex_first_article_review_year_by_focal_year
        BETWEEN 11 AND 19

        THEN 3


    WHEN
        h.accepted_year
        -
        cy.openalex_first_article_review_year_by_focal_year
        BETWEEN 20 AND 29

        THEN 4


    WHEN
        h.accepted_year
        -
        cy.openalex_first_article_review_year_by_focal_year
        >= 30

        THEN 5


    ELSE NULL

END AS career_stage_order,


/*==============================================================================
      CAREER-HISTORY AVAILABILITY FLAG
==============================================================================*/

/*
TRUE:
    No qualifying OpenAlex article/review observed by the focal year.

This is retained so SI analyses can distinguish:

    observed age = 0

from

    age = 0 because the prior OpenAlex history is unobserved.
*/

CASE

    WHEN
        cy.openalex_first_article_review_year_by_focal_year IS NULL

        THEN TRUE

    ELSE FALSE

END AS career_start_unobserved_by_focal_year,


/*==============================================================================
      CAREER-AGE DIAGNOSTIC
==============================================================================*/

/*
Observations with implied age >70 remain in the data and remain classified
according to the broad career-stage bins.

This flag is diagnostic for sensitivity analyses.
*/

CASE

    WHEN
        cy.openalex_first_article_review_year_by_focal_year IS NOT NULL

        AND
        h.accepted_year
        -
        cy.openalex_first_article_review_year_by_focal_year
        > 70

        THEN TRUE

    ELSE FALSE

END AS career_age_over_70,


    /*==========================================================================
      OPENALEX-WIDE PRIOR PRODUCTIVITY
    ==========================================================================*/

    COALESCE(
        prod.openalex_prior_article_review_count,
        0
    ) AS openalex_prior_article_review_count,

    prod.prior_productivity_bin,

    prod.prior_productivity_bin_order,


    /*==========================================================================
      STRICTLY PRIOR STUDY-CORPUS HISTORY
    ==========================================================================*/

    COALESCE(
        h.prior_corpus_papers,
        0
    ) AS prior_corpus_papers,

    COALESCE(
        h.prior_first_author_papers,
        0
    ) AS prior_first_author_papers,

    COALESCE(
        h.prior_last_author_papers,
        0
    ) AS prior_last_author_papers,

    COALESCE(
        h.prior_corresponding_papers,
        0
    ) AS prior_corresponding_papers,


    /*==========================================================================
      PRIOR TEAM HISTORY
    ==========================================================================*/

    COALESCE(
        h.prior_team_papers,
        0
    ) AS prior_team_papers,

    COALESCE(
        h.prior_sum_authors,
        0
    ) AS prior_sum_authors,

    SAFE_DIVIDE(
        h.prior_sum_authors,
        h.prior_team_papers
    ) AS prior_mean_team_size,


    /*==========================================================================
      PRIOR TEAM DISTRIBUTION
    ==========================================================================*/

    COALESCE(
        h.prior_solo_papers,
        0
    ) AS prior_solo_papers,

    COALESCE(
        h.prior_2_3_papers,
        0
    ) AS prior_2_3_papers,

    COALESCE(
        h.prior_4_6_papers,
        0
    ) AS prior_4_6_papers,

    COALESCE(
        h.prior_7_10_papers,
        0
    ) AS prior_7_10_papers,

    COALESCE(
        h.prior_11_19_papers,
        0
    ) AS prior_11_19_papers,

    COALESCE(
        h.prior_20plus_papers,
        0
    ) AS prior_20plus_papers,


    /*==========================================================================
      PRIOR TEAM SHARES
    ==========================================================================*/

    SAFE_DIVIDE(
        h.prior_solo_papers,
        h.prior_team_papers
    ) AS prior_solo_share,

    SAFE_DIVIDE(
        h.prior_2_3_papers,
        h.prior_team_papers
    ) AS prior_2_3_share,

    SAFE_DIVIDE(
        h.prior_4_6_papers,
        h.prior_team_papers
    ) AS prior_4_6_share,

    SAFE_DIVIDE(
        h.prior_7_10_papers,
        h.prior_team_papers
    ) AS prior_7_10_share,

    SAFE_DIVIDE(
        h.prior_11_19_papers,
        h.prior_team_papers
    ) AS prior_11_19_share,

    SAFE_DIVIDE(
        h.prior_20plus_papers,
        h.prior_team_papers
    ) AS prior_20plus_share,


    /*==========================================================================
      FIXED PRE-DIFFUSION PROFILE
    ==========================================================================*/

    b.baseline_papers,

    b.baseline_first_author_papers,

    b.baseline_last_author_papers,

    b.baseline_corresponding_papers,

    b.baseline_team_papers,

    b.baseline_mean_team_size,

    b.baseline_median_team_size,

    b.baseline_solo_papers,

    b.baseline_2_3_papers,

    b.baseline_4_6_papers,

    b.baseline_7_10_papers,

    b.baseline_11_19_papers,

    b.baseline_20plus_papers,

    b.baseline_solo_share,

    b.baseline_2_3_share,

    b.baseline_4_6_share,

    b.baseline_7_10_share,

    b.baseline_11_19_share,

    b.baseline_20plus_share,

    b.adequate_baseline_team_history,

    b.strong_baseline_team_history,

    m.baseline_modal_team_regime,


    /*==========================================================================
      AUTHOR PANEL COUNTS
    ==========================================================================*/

    COUNTIF(
        h.accepted_date <= DATE '2022-09-30'
    ) OVER (
        PARTITION BY h.author_id
    ) AS n_baseline_papers_author,


    COUNTIF(
        h.accepted_date BETWEEN
            DATE '2022-10-01'
            AND DATE '2023-06-30'
    ) OVER (
        PARTITION BY h.author_id
    ) AS n_transition_papers_author,


    COUNTIF(
        h.accepted_date >= DATE '2023-07-01'
    ) OVER (
        PARTITION BY h.author_id
    ) AS n_post_papers_author,


    /*==========================================================================
      PERIOD FLAGS
    ==========================================================================*/

    (
        COUNTIF(
            h.accepted_date <= DATE '2022-09-30'
        ) OVER (
            PARTITION BY h.author_id
        ) > 0
    ) AS has_baseline_paper,


    (
        COUNTIF(
            h.accepted_date BETWEEN
                DATE '2022-10-01'
                AND DATE '2023-06-30'
        ) OVER (
            PARTITION BY h.author_id
        ) > 0
    ) AS has_transition_paper,


    (
        COUNTIF(
            h.accepted_date >= DATE '2023-07-01'
        ) OVER (
            PARTITION BY h.author_id
        ) > 0
    ) AS has_post_paper,


    /*==========================================================================
      BASELINE + POST STAYER
    ==========================================================================*/

    (
        COUNTIF(
            h.accepted_date <= DATE '2022-09-30'
        ) OVER (
            PARTITION BY h.author_id
        ) > 0

        AND

        COUNTIF(
            h.accepted_date >= DATE '2023-07-01'
        ) OVER (
            PARTITION BY h.author_id
        ) > 0
    ) AS has_baseline_and_post_paper,


    /*==========================================================================
      STRONG STAYER
    ==========================================================================*/

    (
        COUNTIF(
            h.accepted_date <= DATE '2022-09-30'
        ) OVER (
            PARTITION BY h.author_id
        ) >= 2

        AND

        COUNTIF(
            h.accepted_date >= DATE '2023-07-01'
        ) OVER (
            PARTITION BY h.author_id
        ) >= 2
    ) AS has_2plus_baseline_and_post_papers,


    /*==========================================================================
      BASELINE HISTORY QUALITY
    ==========================================================================*/

    (
        b.baseline_team_papers >= 3
    ) AS has_3plus_baseline_papers,


    (
        b.baseline_team_papers >= 5
    ) AS has_5plus_baseline_papers


FROM `redo.ai_author_rolling_history_stage` AS h


/*==============================================================================
JOIN 1. TEMPORALLY VALID CAREER START
==============================================================================*/

LEFT JOIN `redo.ai_openalex_career_by_author_year` AS cy

    ON h.author_id = cy.author_id

    AND h.accepted_year = cy.accepted_year


/*==============================================================================
JOIN 2. OPENALEX-WIDE RAW TOTAL PUBLICATION COUNT
==============================================================================*/

LEFT JOIN `redo.ai_openalex_author_career` AS oa

    ON h.author_id = oa.author_id


/*==============================================================================
JOIN 3. OPENALEX-WIDE PRIOR PRODUCTIVITY
==============================================================================*/

LEFT JOIN `redo.ai_openalex_prior_productivity_binned` AS prod

    ON h.author_id = prod.author_id

    AND h.accepted_year = prod.accepted_year


/*==============================================================================
JOIN 4. FIXED BASELINE PROFILE
==============================================================================*/

LEFT JOIN `redo.ai_baseline_author_profile_final` AS b

    ON h.author_id = b.author_id


/*==============================================================================
JOIN 5. BASELINE MODAL TEAM REGIME
==============================================================================*/

LEFT JOIN `redo.ai_baseline_team_mode` AS m

    ON h.author_id = m.author_id;


