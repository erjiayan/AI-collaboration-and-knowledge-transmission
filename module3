/*==============================================================================
SECTION 5. FINAL CAREER QC

This is the only QC needed immediately after the rebuild.

Expected:
    negative_age = 0

Missing career stage is allowed because some OpenAlex author histories begin
after the focal paper or cannot be established from the available OpenAlex
record.

Age > 70 is retained and flagged rather than automatically deleted.
==============================================================================*/

SELECT

    CASE

        WHEN approximate_career_age IS NULL
            THEN 'missing'

        WHEN approximate_career_age < 0
            THEN 'negative'

        WHEN approximate_career_age > 70
            THEN 'over_70'

        ELSE 'valid'

    END AS career_age_status,

    COUNT(*) AS n_author_paper_rows,

    COUNT(DISTINCT author_id) AS n_authors,

    MIN(approximate_career_age) AS min_age,

    MAX(approximate_career_age) AS max_age

FROM `redo.ai_author_history`

GROUP BY career_age_status

ORDER BY

    CASE career_age_status
        WHEN 'negative' THEN 1
        WHEN 'missing' THEN 2
        WHEN 'over_70' THEN 3
        WHEN 'valid' THEN 4
        ELSE 5
    END;
